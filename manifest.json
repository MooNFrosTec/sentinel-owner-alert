{
  "manifest_version": 3,
  "name": "Sentinel Owner Alert",
  "version": "3.3.0",
  "description": "Monitors visible Microsoft Sentinel incidents and alerts when they match configured owner, severity, and schedule rules.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/MooNFrosTec/sentinel-owner-alert",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://portal.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sentinel Owner Alert",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.azure.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "alert.wav"
      ],
      "matches": [
        "https://portal.azure.com/*"
      ]
    }
  ]
}
