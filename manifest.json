{
  "manifest_version": 3,
  "name": "Sentinel Owner Alert",
  "version": "3.2.2",
  "description": "Zvukove a desktop upozorneni pro Microsoft Sentinel incidenty podle ownera, severity, pracovnich hodin a stavu auto-refresh.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://portal.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sentinel Owner Alert",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.azure.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "alert.mp3"
      ],
      "matches": [
        "https://portal.azure.com/*"
      ]
    }
  ]
}
