{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.6.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/MooNFrosTec/sentinel-owner-alert",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://portal.azure.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.azure.com/*"
      ],
      "js": [
        "custom-severity.js",
        "owner-utils.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "alert.wav"
      ],
      "matches": [
        "https://portal.azure.com/*"
      ]
    }
  ]
}
